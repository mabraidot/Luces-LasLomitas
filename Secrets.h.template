/*
  Secrets.h.template - Plantilla de credenciales.

  Este archivo SI se versiona; Secrets.h no. Para trabajar en otra maquina:

      cp Secrets.h.template Secrets.h        (o copiar y renombrar a mano)

  y completar los valores. Secrets.h esta en el .gitignore, asi que lo que se
  escriba ahi no sale del equipo.

  Si algun dia hay que agregar una credencial nueva, agregarla ACA tambien: es
  la unica lista de que hace falta para compilar en limpio.
*/

#ifndef SECRETS_H
#define SECRETS_H

// Red WiFi local.
#define WIFI_SSID       "PONER_SSID_ACA"
#define WIFI_PASSWORD   "PONER_PASSWORD_ACA"

/*
  Contrasena para subir firmware por WiFi. Vacia = sin contrasena.

  Sin contrasena, cualquiera en la red local puede reprogramar la placa, y esta
  placa maneja 220 V. En una red domestica el riesgo es bajo, pero ponerla
  cuesta una linea. El costo es que el IDE la pide en cada subida.
*/
#define OTA_PASSWORD    "PONER_OTA_PASSWORD_ACA"

// Expresion C++ normal, NO para usar en #if: el preprocesador no evalua
// indexado de cadenas. El compilador la resuelve igual en tiempo de
// compilacion, asi que un 'if (OTA_HAS_PASSWORD)' no cuesta nada en ejecucion.
#define OTA_HAS_PASSWORD  (OTA_PASSWORD[0] != 0)

#endif // SECRETS_H
